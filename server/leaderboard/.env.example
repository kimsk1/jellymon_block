# Server only. Do not copy these values into APK/config JSON.
HIVE_APP_ID=com.jellymon.game
HIVE_ALLOWED_APP_IDS=com.jellymon.game,com.jellymontest.game
HIVE_LEADERBOARD_ID=163
HIVE_CERTIFICATION_KEY=
HIVE_ZONE=sandbox
RANKING_DB_PATH=./data/ranking.sqlite3
PORT=8787
# Public DNS name, without https:// or a path. Used by the optional https service.
RANKING_DOMAIN=ranking.example.com

# npm start default: loopback. Container hosting may set 0.0.0.0.
HOST=127.0.0.1
# Google Play / App Store IAP: 콘솔 등록과 라이선스 테스트 준비 후 true
HIVE_IAP_ENABLED=false
# Hive IAP 인증 사용(Y)일 때 해당 인증 키. OAuth secret/DataStore 공개키가 아님.
HIVE_IAP_AUTH_KEY=
# 테스트 단계는 false 유지. live 환경과 true가 모두 설정돼야 실제 영수증 허용.
HIVE_IAP_ALLOW_REAL=false

# iOS Hive App ID와 App Store Connect Bundle ID를 각각 명시. 비어 있으면 iOS 결제 차단.
HIVE_IAP_IOS_APP_ID=com.jellymontest.game
HIVE_IAP_IOS_BUNDLE_ID=com.jellymontest.game
