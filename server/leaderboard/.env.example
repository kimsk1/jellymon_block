# Server only. Do not copy these values into APK/config JSON.
HIVE_APP_ID=com.jellymon.game
HIVE_LEADERBOARD_ID=163
HIVE_CERTIFICATION_KEY=
HIVE_ZONE=sandbox
RANKING_DB_PATH=./data/ranking.sqlite3
PORT=8787
# Public DNS name, without https:// or a path. Used by the optional https service.
RANKING_DOMAIN=ranking.example.com

# npm start default: loopback. Container hosting may set 0.0.0.0.
HOST=127.0.0.1
